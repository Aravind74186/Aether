# ==============================================================================
# AETHER TECHNOLOGIES - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Public App URL (Used for Canonical URLs and Open Graph tags)
NEXT_PUBLIC_SITE_URL=https://aethertech.example.com

# Lead & Intake Dispatch Webhook (Optional: Slack, Discord, Zapier, or CRM)
LEAD_WEBHOOK_URL=

# Transactional Email Dispatcher (Optional: Resend API Key)
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=hello@aethertech.example.com

# Admin Authentication & Session Secrets
# Generate a strong 32+ character string (e.g. openssl rand -base64 32)
AUTH_SECRET=your_super_secret_auth_token_key_here
SESSION_SECRET=your_session_encryption_secret_key_here

# Initial Admin User Credentials (Used for automatic bootstrapping/seeding)
ADMIN_EMAIL=admin@aethertech.com
ADMIN_PASSWORD=change_this_secure_admin_password_in_production

# Optional Database & Storage Configuration (Defaults to atomic local storage in development)
DATABASE_URL=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Legacy Passphrase
ADMIN_PASSPHRASE=aether2025

# Redis / Upstash Cache & Distributed Rate Limiter (Optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
